PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/mukt_kavya
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Brevo (formerly Sendinblue) Email API
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@muktkavya.com
BREVO_SENDER_NAME=Mukt Kavya

FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Render Keep-Alive Configuration (Bypasses 15-minute free tier cold start)
# On Render, RENDER_EXTERNAL_URL is set automatically.
# Alternatively, set SERVER_URL to your Render web service URL:
# SERVER_URL=https://your-mukt-kavya-backend.onrender.com
# Ping frequency in minutes (Default: 14 to stay ahead of the 15-minute timer)
KEEP_ALIVE_INTERVAL_MINUTES=14
